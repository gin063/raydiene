--- a/node_modules/@nuxt/image/dist/runtime/providers/aliyun.js
+++ b/node_modules/@nuxt/image/dist/runtime/providers/aliyun.js
@@ -37,8 +37,46 @@ export default defineProvider({
       _modifiers.quality = `Q_${quality}`;
     }
     const operations = operationsGenerator(_modifiers);
-    return {
